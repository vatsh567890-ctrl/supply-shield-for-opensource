# SupplyShield Environment Configuration Template
# Only variable names defined in Section 12 are permitted. Never commit real secrets.

# Backend Application
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://supplyshield:supplyshield@localhost:5432/supplyshield
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=dev_session_secret_change_me_to_random_32_bytes_in_production

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=dev_webhook_secret_change_in_prod

# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=mock_client_id
GITHUB_OAUTH_CLIENT_SECRET=mock_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# LLM Provider (gemini | anthropic | none)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro
LLM_MAX_INPUT_TOKENS=60000

# Analyzer Limits
ANALYSIS_MAX_FILES=5000
ANALYSIS_MAX_TOTAL_BYTES=209715200
ANALYSIS_MAX_ARTIFACT_BYTES=52428800
ANALYSIS_TIMEOUT_SECONDS=240

# External Integrations
OSV_API_URL=https://api.osv.dev
LOG_LEVEL=INFO

# Frontend
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SupplyShield
